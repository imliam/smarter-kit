        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript-eslint": "^8.59.4"
    },
    "dependencies": {
        "@laravel/passkeys": "^0.1.0",
        "@tailwindcss/vite": "^4.3.0",
        "autoprefixer": "^10.5.0",
        "concurrently": "^9.2.1",
