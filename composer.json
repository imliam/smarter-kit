{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.6.1",
        "laravel/ai": "^0.6.4",
        "laravel/fortify": "^1.36.2",
        "laravel/framework": "^13.6",
        "laravel/octane": "^2.17.2",
        "laravel/sanctum": "^4.3.1",
        "laravel/tinker": "^3.0.2",
        "livewire/blaze": "^1.0.11",
        "livewire/flux": "^2.14.1",
        "livewire/livewire": "^4.2.4",
        "spatie/laravel-morph-map-generator": "^1.4",
        "spatie/laravel-sluggable": "^3.8.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2.8",
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.3",
        "fakerphp/faker": "^1.24.1",
        "imliam/laravel-env-set-command": "^3.0",
        "knuckleswtf/scribe": "^5.9",
        "larastan/larastan": "^3.9.6",
        "laravel/boost": "^2.4.6",
        "laravel/pail": "^1.2.6",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.29.1",
        "laravel/sail": "^1.57",
        "mockery/mockery": "^1.6.12",
        "mrpunyapal/peststan": "^0.2.8",
        "mrpunyapal/rector-pest": "^0.2.11",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.6.3",
        "pestphp/pest-plugin-browser": "^4.3.1",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "rector/rector": "^2.4.2",
        "spatie/laravel-error-solutions": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@php artisan test --parallel",
            "phpstan analyse --ansi --memory-limit=-1"
        ],
        "optimize": [
            "@php artisan optimize:clear --ansi",
            "@php artisan optimize --ansi",
            "@php artisan filament:optimize"
        ],
        "test:coverage": [
            "pest --type-coverage --min=100",
            "XDEBUG_MODE=\"coverage\" pest --parallel --coverage --exactly=100.0"
        ],
        "fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan ide-helper:models --nowrite",
            "vendor/bin/rector",
            "@lint",
            "bun run format",
            "bun run lint"
        ],
        "update-dependencies": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan morph-map:cache",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --nowrite",
            "@php artisan ide-helper:eloquent",
            "@php artisan filament:upgrade",
            "@php artisan icons:cache",
            "@php artisan scribe:generate --quiet --no-interaction"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed --ansi",
            "bun install",
            "bunx playwright install",
            "bun run build"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
